@model List<MyWebsite1.Models.Photo>
@{
    ViewData["Title"] = "Browse Feed";
    ViewData["CurrentPage"] = "Browse Feed";
}

<div class="container mt-4">
    <h1 class="text-center">@ViewData["Title"]</h1>

    <div class="row justify-content-center">
        @foreach (var photoWithIndex in Model.Select((photo, index) => new { photo, index }))
        {
            <div class="col-12 mb-3 @(photoWithIndex.index == 0 ? "mt-5" : "")">
                <div class="card">
                    @* Display image if it exists *@
                    @if (photoWithIndex.photo.ImageData != null && photoWithIndex.photo.ImageData.Length > 0)
                    {
                        <img src="data:image;base64,@Convert.ToBase64String(photoWithIndex.photo.ImageData)"
                             class="card-img-top"
                             alt="@photoWithIndex.photo.Title"
                             loading="lazy" />
                        <div class="card-body text-center">
                            <h5 class="card-title">@photoWithIndex.photo.Title</h5>
                            <p class="card-text">@photoWithIndex.photo.DateCreated.ToString("MM/dd/yyyy")</p>
                            <a href="@Url.Action("Details", "Gallery", new { id = photoWithIndex.photo.Id })" class="btn btn-pink">View Photo</a>
                        </div>
                    }
                    else
                    {
                        <div class="card-body text-center">
                            <p>No image available.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
